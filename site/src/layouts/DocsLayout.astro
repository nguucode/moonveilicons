---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = [
  ['getting-started', 'Getting started'],
  ['react', 'React'],
  ['vue', 'Vue'],
  ['web-components', 'Web Component'],
  ['webfont', 'Webfont + CSS'],
  ['cdn', 'CDN & raw SVG'],
  ['cli', 'CLI'],
  ['contributing', 'Adding icons'],
];
const current = Astro.url.pathname.replace(/\.html$/, '').split('/').pop();
---

<BaseLayout title={`${frontmatter.title} · Moonveil Icons`} description={frontmatter.description}>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-8 md:flex-row md:py-12">
    <nav aria-label="Docs" class="md:w-52 md:shrink-0">
      <ul class="flex gap-1 overflow-x-auto text-sm md:sticky md:top-20 md:flex-col">
        {pages.map(([slug, label]) => (
          <li>
            <a href={`${base}/docs/${slug}`} aria-current={slug === current ? 'page' : undefined} class:list={['block whitespace-nowrap rounded-md px-3 py-2 hover:bg-element-hover', slug === current ? 'bg-accent-subtle font-medium text-accent-text' : 'text-text-muted']}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <article class="prose min-w-0 max-w-3xl flex-1">
      <slot />
    </article>
  </div>
</BaseLayout>
