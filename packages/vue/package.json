{
  "name": "@moonveilicons/vue",
  "version": "0.0.0",
  "description": "Moonveil Icons for Vue 3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "vue": "^3.5.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguucode/moonveilicons.git",
    "directory": "packages/vue"
  },
  "homepage": "https://ontheshore.biz/moonveilicons/",
  "bugs": "https://github.com/nguucode/moonveilicons/issues",
  "keywords": [
    "moonveilicons",
    "icons",
    "vue"
  ],
  "publishConfig": {
    "access": "public"
  }
}
