{
  "name": "@moonveilicons/react",
  "version": "0.0.0",
  "description": "Moonveil Icons for React",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguucode/moonveilicons.git",
    "directory": "packages/react"
  },
  "homepage": "https://ontheshore.biz/moonveilicons/",
  "bugs": "https://github.com/nguucode/moonveilicons/issues",
  "keywords": [
    "moonveilicons",
    "icons",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
