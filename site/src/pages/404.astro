---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Not found · Moonveil Icons">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-sm text-text-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This page drifted off</h1>
    <p class="mt-3 text-text-muted">The link may be old, or the page moved.</p>
    <a href={`${base}/`} class="mt-8 inline-flex h-11 items-center rounded-md bg-accent px-5 font-medium text-on-accent hover:bg-accent-hover">Browse icons</a>
  </div>
</BaseLayout>
